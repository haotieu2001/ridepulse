{
  "datasets": [
    {
      "name": "daily",
      "displayName": "Daily economics",
      "queryLines": [
        "SELECT pickup_date, MEASURE(trips) AS trips, MEASURE(gmv) AS gmv, MEASURE(driver_pay) AS driver_pay,\n",
        "MEASURE(take_rate) AS take_rate, MEASURE(cbd_fees) AS cbd_fees, MEASURE(cbd_trips) AS cbd_trips\n",
        "FROM ridepulse_dev.gold.mv_trip_economics GROUP BY pickup_date\n"
      ]
    },
    {
      "name": "hourly",
      "displayName": "Trips by hour and borough",
      "queryLines": [
        "SELECT borough, pickup_hour, MEASURE(trips) AS trips FROM ridepulse_dev.gold.mv_trip_economics GROUP BY ALL\n"
      ]
    },
    {
      "name": "recon",
      "displayName": "Reconciliations",
      "queryLines": [
        "SELECT reconciliation, day, checked, breaks FROM ridepulse_dev.gold.agg_recon_daily\n"
      ]
    },
    {
      "name": "fees",
      "displayName": "Fee checks",
      "queryLines": [
        "SELECT fee, sum(trips_charged) AS trips_charged, sum(collected) AS collected, sum(expected) AS expected,\n",
        "sum(breaks) AS breaks FROM ridepulse_dev.gold.recon_fees WHERE breaks IS NOT NULL GROUP BY fee\n"
      ]
    },
    {
      "name": "health",
      "displayName": "Platform health",
      "queryLines": [
        "SELECT checked_at, metric, value, limit_value, ok FROM ridepulse_dev.ops.platform_health\n"
      ]
    },
    {
      "name": "dq_rows",
      "displayName": "DQ: rows per snapshot",
      "queryLines": [
        "SELECT window.start AS snapshot_at, count AS row_count\n",
        "FROM ridepulse_dev.ops.fct_trips_profile_metrics WHERE column_name = ':table'\n"
      ]
    },
    {
      "name": "dq_latest",
      "displayName": "DQ: latest snapshot per column",
      "queryLines": [
        "SELECT column_name, round(percent_null, 1) AS percent_null,\n",
        "round(percent_zeros, 1) AS percent_zeros, CASE WHEN column_name = 'cbd_fee' THEN 'expected: zero for trips outside the CBD' END AS note\n",
        "FROM ridepulse_dev.ops.fct_trips_profile_metrics\n",
        "WHERE column_name <> ':table' AND window.start = (SELECT max(window.start) FROM ridepulse_dev.ops.fct_trips_profile_metrics)\n"
      ]
    },
    {
      "name": "payout_breaks",
      "displayName": "Payout breaks",
      "queryLines": [
        "SELECT week_start, driver_id, break, earned_cents, paid_cents FROM ridepulse_dev.gold.recon_payouts WHERE break IS NOT NULL\n"
      ]
    }
  ],
